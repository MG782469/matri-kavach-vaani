# mock: text drafts only. live: calls Gnani Prisma for uploaded audio.
GNANI_MODE=mock
GNANI_API_KEY=
# Prisma STT profile: hindi (v2.5, hi-IN, native-numeral ITN; default, verified)
# or codemix (v3.0, hi-IN,en-IN, English words kept in Latin script; test before demo).
GNANI_STT_PROFILE=hindi
# Do not set to a production clinical backend without authorization.
# REFERRAL_BACKEND_URL=
# Timbre TTS: select a matching pair. Defaults to timbre-v2.5 / Nalini.
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_VOICE=Nalini
# Alternative v3 pair: timbre-v3.0 / Shivani
# Stage 10 optional PUBLIC synthetic preview only (never use for live Gnani credits):
# DEMO_PUBLIC=1
# DEMO_ACCESS_PASSWORD=choose-a-unique-long-password
